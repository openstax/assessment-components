  border-color: #C22032;
}

.c0.openstax-question:not(.openstax-question-preview).has-incorrect-answer .answer-incorrect.answer-selected.answer-incorrect .answer-letter-wrapper::before {
  color: #fff;
  border-color: #C22032;
  background-color: #C22032;
}

.c0.openstax-question:not(.openstax-question-preview) .question-feedback {
  font-family: "Neue Helvetica W01",Helvetica,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,"Noto Sans","Liberation Sans",sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji";
  font-style: normal;
  font-weight: 400;
  line-height: 1.6;
  text-align: left;
  text-align: start;
  -webkit-text-decoration: none;
  text-decoration: none;
  text-shadow: none;
  text-transform: none;
  -webkit-letter-spacing: normal;
  -moz-letter-spacing: normal;
  -ms-letter-spacing: normal;
  letter-spacing: normal;
  word-break: normal;
  word-spacing: normal;
  white-space: normal;
  line-break: auto;
  z-index: 1;
  position: relative;
  border: 1px solid rgba(0,0,0,0.2);
  background-color: #ffffff;
  background-clip: padding-box;
  max-width: 325px;
  margin: calc(8px - 14px) 0 1rem 8px;
  box-shadow: 0px 4px 4px rgba(0,0,0,0.1);
  color: #6f6f6f;
  font-size: calc(1.4rem * var(--content-text-scale));
  max-width: 370px;
}

.c0.openstax-question:not(.openstax-question-preview) .question-feedback .arrow {
  position: absolute;
  display: block;
  width: 16px;
  height: 8px;
  margin-left: 9px;
  top: calc(8px * -1);
}

.c0.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::before,
.c0.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::after {
  position: absolute;
  display: block;
  content: "";
  border-color: transparent;
  border-style: solid;
  border-width: 0 calc(16px / 2) 8px calc(16px / 2);
}

.c0.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::before {
  top: 0;
  border-bottom-color: rgba(0,0,0,0.2);
}

.c0.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::after {
  top: 1px;
  border-bottom-color: #ffffff;
}

.c0.openstax-question:not(.openstax-question-preview) .question-feedback.right {
  right: calc(-9px - 1px);
}

.c0.openstax-question:not(.openstax-question-preview) .question-feedback.right .arrow {
  right: 9px;
}

.c0.openstax-question:not(.openstax-question-preview) .question-feedback > .content {
  padding: 1rem 0.8rem;
}

.c0.openstax-question:not(.openstax-question-preview) .question-feedback .question-feedback-content {
  padding: 0.9rem 1.1rem;
}

.c0.openstax-question .openstax-answer {
  border-top: 1px solid #d5d5d5;
  margin: 10px 0;
  padding: 6px 8px;
}

@media (max-width:999px) {
  .c0.step-card-body {
    padding: 24px 24px;
  }
}

@media (max-width:600px) {
  .c0.step-card-body {
    padding: calc(8px * 2) 8px;
  }
}

<div
  className="c0 openstax-question"
  data-question-number={1}
  data-test-id="question"
>
  <div
    className="c1"
  >
    <div>
      <div
        className="c2 question-stem"
        dangerouslySetInnerHTML={
          Object {
            "__html": "Is this a question?",
          }
        }
        data-question-number={1}
      />
      <div
        aria-label="Answer choices"
        className="answers-table"
        role="radiogroup"
      >
        <div
          className="openstax-answer"
        >
          <section
            className="answers-answer disabled"
          >
            <input
              checked={false}
              className="answer-input-box"
              disabled={true}
              id="1-option-0"
              name="1-options"
              onChange={[Function]}
              type="radio"
            />
            <label
              className="answer-label"
              htmlFor="1-option-0"
            >
              <span
                aria-label="Choice A:"
                className="answer-letter-wrapper"
                data-answer-choice="A"
                data-test-id="answer-choice-A"
              />
              <div
                aria-atomic="true"
                aria-live="polite"
                className="answer-answer"
                role="status"
              >
                <span
                  className="c2 answer-content"
                  dangerouslySetInnerHTML={
                    Object {
                      "__html": "True",
                    }
                  }
                />
              </div>
            </label>
          </section>
        </div>
        <div
          className="openstax-answer"
        >
          <section
            className="answers-answer disabled"
          >
            <input
              checked={false}
              className="answer-input-box"
              disabled={true}
              id="1-option-1"
              name="1-options"
              onChange={[Function]}
              type="radio"
            />
            <label
              className="answer-label"
              htmlFor="1-option-1"
            >
              <span
                aria-label="Choice B:"
                className="answer-letter-wrapper"
                data-answer-choice="B"
                data-test-id="answer-choice-B"
              />
              <div
                aria-atomic="true"
                aria-live="polite"
                className="answer-answer"
                role="status"
              >
                <span
                  className="c2 answer-content"
                  dangerouslySetInnerHTML={
                    Object {
                      "__html": "False",
                    }
                  }
                />
              </div>
            </label>
          </section>
        </div>
      </div>
      <div
        className="formats-listing"
      >
        <div
          className="header"
        >
          Formats:
        </div>
        <span>
          true-false
        </span>
      </div>
    </div>
  </div>
</div>
`;
