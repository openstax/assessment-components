              />
              <div
                aria-atomic="true"
                aria-live="polite"
                className="answer-answer"
                role="status"
              >
                <span
                  className="c2 answer-content"
                  dangerouslySetInnerHTML={
                    Object {
                      "__html": "False",
                    }
                  }
                />
              </div>
            </label>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>
