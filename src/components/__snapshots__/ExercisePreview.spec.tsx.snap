  z-index: 1;
  position: relative;
  border: 1px solid rgba(0,0,0,0.2);
  background-color: #ffffff;
  background-clip: padding-box;
  max-width: 325px;
  margin: calc(8px - 14px) 0 1rem 8px;
  box-shadow: 0px 4px 4px rgba(0,0,0,0.1);
  color: #6f6f6f;
  font-size: calc(1.4rem * var(--content-text-scale));
  max-width: 370px;
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow {
  position: absolute;
  display: block;
  width: 16px;
  height: 8px;
  margin-left: 9px;
  top: calc(8px * -1);
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::before,
.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::after {
  position: absolute;
  display: block;
  content: "";
  border-color: transparent;
  border-style: solid;
  border-width: 0 calc(16px / 2) 8px calc(16px / 2);
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::before {
  top: 0;
  border-bottom-color: rgba(0,0,0,0.2);
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::after {
  top: 1px;
  border-bottom-color: #ffffff;
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback.right {
  right: calc(-9px - 1px);
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback.right .arrow {
  right: 9px;
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback > .content {
  padding: 1rem 0.8rem;
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .question-feedback-content {
  padding: 0.9rem 1.1rem;
}

.c9.openstax-question .openstax-answer {
