.c9.openstax-question:not(.openstax-question-preview):not(.has-correct-answer) .answer-input-box:focus-visible + .answer-label .answer-letter-wrapper::before {
  outline-style: solid;
  outline-width: 2px;
  outline-offset: 2px;
  outline-color: #026AA1;
}

.c9.openstax-question:not(.openstax-question-preview):not(.has-correct-answer) .answer-selected .answer-label .answer-letter-wrapper::before,
.c9.openstax-question:not(.openstax-question-preview):not(.has-correct-answer) .answer-selected .answer-label:hover .answer-letter-wrapper::before {
  color: #fff;
  border-color: #026AA1;
  background-color: #026AA1;
}

.c9.openstax-question:not(.openstax-question-preview).has-correct-answer .answer-selected:not(.answer-correct) .answer-label .answer-letter-wrapper::before {
  color: #fff;
  border-color: #C22032;
  background-color: #C22032;
}

.c9.openstax-question:not(.openstax-question-preview).has-correct-answer .answer-selected.answer-correct .answer-label .answer-letter-wrapper::before {
  color: #fff;
  border-color: #0D7741;
  background-color: #0D7741;
}

.c9.openstax-question:not(.openstax-question-preview).has-correct-answer .answer-correct:not(.answer-selected) .answer-label .answer-letter-wrapper::before {
  color: #0D7741;
  border-color: #0D7741;
}

.c9.openstax-question:not(.openstax-question-preview).has-incorrect-answer .answer-incorrect .answer-label .answer-letter-wrapper::before,
.c9.openstax-question:not(.openstax-question-preview).has-incorrect-answer .answer-incorrect .answer-label:hover .answer-letter-wrapper::before {
  color: #C22032;
  border-color: #C22032;
}

.c9.openstax-question:not(.openstax-question-preview).has-incorrect-answer .answer-incorrect.answer-selected.answer-incorrect .answer-letter-wrapper::before {
  color: #fff;
  border-color: #C22032;
  background-color: #C22032;
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback {
  font-family: "Neue Helvetica W01",Helvetica,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,"Noto Sans","Liberation Sans",sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji";
  font-style: normal;
  font-weight: 400;
  line-height: 1.6;
  text-align: left;
  text-align: start;
  -webkit-text-decoration: none;
  text-decoration: none;
  text-shadow: none;
  text-transform: none;
  -webkit-letter-spacing: normal;
  -moz-letter-spacing: normal;
  -ms-letter-spacing: normal;
  letter-spacing: normal;
  word-break: normal;
  word-spacing: normal;
  white-space: normal;
  line-break: auto;
  z-index: 1;
  position: relative;
  border: 1px solid rgba(0,0,0,0.2);
  background-color: #ffffff;
  background-clip: padding-box;
  max-width: 325px;
  margin: calc(8px - 14px) 0 1rem 8px;
  box-shadow: 0px 4px 4px rgba(0,0,0,0.1);
  color: #6f6f6f;
  font-size: calc(1.4rem * var(--content-text-scale));
  max-width: 370px;
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow {
  position: absolute;
  display: block;
  width: 16px;
  height: 8px;
  margin-left: 9px;
  top: calc(8px * -1);
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::before,
.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::after {
  position: absolute;
  display: block;
  content: "";
  border-color: transparent;
  border-style: solid;
  border-width: 0 calc(16px / 2) 8px calc(16px / 2);
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::before {
  top: 0;
  border-bottom-color: rgba(0,0,0,0.2);
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::after {
  top: 1px;
  border-bottom-color: #ffffff;
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback.right {
  right: calc(-9px - 1px);
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback.right .arrow {
  right: 9px;
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback > .content {
  padding: 1rem 0.8rem;
}

.c9.openstax-question:not(.openstax-question-preview) .question-feedback .question-feedback-content {
  padding: 0.9rem 1.1rem;
}

.c9.openstax-question .openstax-answer {
  border-top: 1px solid #d5d5d5;
  margin: 10px 0;
  padding: 6px 8px;
}

.c9.c9.c9.step-card-body {
  background-color: #ffffff;
  padding: var(--spacing,0.8rem);
  font-size: 1.6rem;
  line-height: 2rem;
}

.c9.c9.c9.openstax-question .answers-table {
  margin: 0;
}

.c9.c9.c9.openstax-question .question-stem {
  color: #424242;
  font-weight: bold;
  font-size: 1.6rem;
  line-height: 2rem;
}

.c9.c9.c9.openstax-question .question-feedback-content {
  font-size: 1.6rem;
  line-height: 2rem;
}

.c9.c9.c9.openstax-question .question-feedback {
  max-width: unset;
}

.c9.c9.c9.openstax-question .openstax-answer {
  padding: 0;
  border: none;
}

.c9.c9.c9.openstax-question .openstax-answer .answer-label {
  padding-top: var(--spacing,0.8rem);
}

.c9.c9.c9.openstax-question .openstax-answer .answer-letter-wrapper .answer-answer {
  margin-left: var(--spacing,0.8rem);
}

.c9.c9.c9.openstax-question .openstax-answer .answer-letter-wrapper::before {
  min-width: 2.3rem;
  min-height: 2.3rem;
  width: 2.3rem;
  height: 2.3rem;
}

.c9.c9.c9.openstax-question .openstax-answer .answer-letter {
  min-width: 2.8rem;
  min-height: 2.8rem;
  width: 2.8rem;
  height: 2.8rem;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
}

.c12 .detailed-solution {
  margin-bottom: 1rem;
}

.c12 .detailed-solution .header {
  display: inline;
  margin-right: 0.5rem;
  color: #5e6062;
  font-weight: bold;
  -webkit-flex-basis: 0;
  -ms-flex-preferred-size: 0;
  flex-basis: 0;
}

.c12 .detailed-solution .solution {
  display: inline;
  color: #6f6f6f;
}

.c11 {
  padding: 4.8rem 14rem 0;
  border-top: 1px solid #d5d5d5;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-wrap: wrap;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  font-size: calc(1.6rem * var(--content-text-scale));
  line-height: calc(2rem * var(--content-text-scale));
  background: #fdfdfd;
  overflow: auto;
}

.c11 > * {
  -webkit-box-flex: 1;
  -webkit-flex-grow: 1;
  -ms-flex-positive: 1;
  flex-grow: 1;
}

.c11 button {
  width: 160px;
  height: 48px;
}

.c11 .step-card-footer-inner {
  padding-top: 32px;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  gap: 1.6rem;
}

.c11 .points .attempts-left {
  color: #B03808;
  font-weight: bold;
}

.c11 .controls {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-flow: row nowrap;
  -ms-flex-flow: row nowrap;
  flex-flow: row nowrap;
  -webkit-box-pack: end;
  -webkit-justify-content: flex-end;
  -ms-flex-pack: end;
  justify-content: flex-end;
  gap: 0.8rem;
  margin-left: auto;
}

.c11 .controls button:has(~ button),
.c11 .controls button + button {
  -webkit-flex-shrink: 1;
  -ms-flex-negative: 1;
  flex-shrink: 1;
  min-width: 0;
  width: 100px;
}

.c11.c11 {
  padding: 0 var(--spacing,0.8rem) var(--spacing,0.8rem);
}

.c11 .step-card-footer-inner {
  padding-top: var(--spacing,0.8rem);
}

.c3 {
  margin: 0 auto auto auto !important;
}

.c3 .step-card-footer {
  display: none;
}

.c3 .answer-answer {
  font-weight: normal;
}

.c3.is-selected {
  background-color: #daf3f8;
  border-width: 0.2rem;
}

.c3.is-selected .step-card-footer,
.c3.is-selected .step-card-body,
.c3.is-selected .step-card-header {
  background-color: #daf3f8 !important;
}

.c3.is-selected .openstax-question {
  border-width: 0.2rem !important;
}

@media (min-width:1000px) {
  .c1 {
    max-width: 1000px;
  }
}

@media (max-width:600px) {
  .c0 {
    padding: 0;
  }
}

@media (min-width:1000px) {
  .c4 button.ox-icon-angle-left,
  .c4 button.ox-icon-angle-right {
    display: none;
  }
}

@media (max-width:999px) {
  .c4 {
    font-size: 1.6rem;
    line-height: 2.5rem;
  }

  .c4 svg.ox-icon {
    display: inherit;
    margin: 0;
  }

  .c4 button.ox-icon-angle-left {
    margin-right: 24px;
  }

  .c4 button.ox-icon-angle-right {
    margin-left: 24px;
  }

  .c4 .openstax-exercise-badges svg {
    display: none;
  }

  .c4 .num-questions,
  .c4 points {
    display: inherit;
  }

  .c4 .exercise-id {
    display: none;
  }

  .c4 button[class^='ox-icon-angle']:hover {
    box-shadow: none;
  }
}

@media (max-width:600px) {
  .c4 {
    font-size: 1.6rem;
    line-height: 2rem;
    padding: 10px 8px;
  }

  .c4 button.ox-icon-angle-left {
    margin-right: 8px;
  }

  .c4 button.ox-icon-angle-left {
    margin-right: 8px;
  }
}

@media (max-width:999px) {
  .c6 .step-card-body {
    padding: 24px 24px;
  }
}

@media (max-width:600px) {
  .c6 .step-card-body {
    padding: calc(8px * 2) 8px;
  }
}

@media (max-width:600px) {
  .c6.c6 .question-feedback {
    margin-left: 0;
  }

  .c6.c6 .question-feedback .arrow {
    margin-left: 12px;
  }
}

@media (min-width:1000px) {
  .video-step .c5 .openstax-exercise-badges,
  .interactive-step .c6 .openstax-exercise-badges {
    margin-right: 3.8rem;
  }
}

@media (max-width:600px) {
  .c6 .openstax-exercise-badges svg {
    margin-right: 8px;
  }
}

@media (max-width:999px) {
  .c9.step-card-body {
    padding: 24px 24px;
  }
}

@media (max-width:600px) {
  .c9.step-card-body {
    padding: calc(8px * 2) 8px;
  }
}

@media (max-width:999px) {
  .c11 {
    padding: 24px 24px;
  }
}

@media (max-width:600px) {
  .c11 {
    padding: calc(8px * 2) 8px;
  }
}

@media (max-width:600px) {
  .c11 .step-card-footer-inner {
    -webkit-flex-wrap: wrap;
    -ms-flex-wrap: wrap;
    flex-wrap: wrap;
  }
}

@media (min-width:1000px) {
  .c11 {
    padding: 0 140px 32px 140px;
    -webkit-flex-wrap: nowrap;
    -ms-flex-wrap: nowrap;
    flex-wrap: nowrap;
  }

  .c11 .points {
    max-width: 400px;
  }
}

<div
  className=""
>
  <div
    className="c0 step-card-outer"
    data-task-step-id="0"
  >
    <div
      className="c1 c2 exercise-step c3 preview-card "
    >
      <div>
        <div
          className="step-card"
        >
          <div
            className="c4 step-card-header"
          >
            <div>
              <h2
                className="question-info"
              >
                <span>
                  Question 1
                </span>
                <span
                  className="separator"
                >
                  |
                </span>
                <span
                  className="question-id"
                >
                  ID: 
                  1@1
                </span>
              </h2>
            </div>
          </div>
          <div
            className="c5 c6"
          >
            <div
              className="c7"
            >
              <div
                className="c8 step-card-body exercise-context"
                dangerouslySetInnerHTML={
                  Object {
                    "__html": "Context",
                  }
                }
              />
              <div
                className="c8 step-card-body exercise-stimulus"
                dangerouslySetInnerHTML={
                  Object {
                    "__html": "<b>Stimulus HTML</b>",
                  }
                }
              />
              <div
                data-test-id="student-exercise-question"
              >
                <div
                  className="c9 openstax-question step-card-body has-correct-answer"
                  data-question-number={1}
                  data-test-id="question"
                >
                  <div
                    className="c10"
                  >
                    <div>
                      <div
                        className="answers-table"
                      >
                        <div
                          className="openstax-answer"
                        >
                          <section
                            className="answers-answer disabled answer-correct"
                          >
                            <input
                              aria-details="feedback-1234@5-0"
                              checked={false}
                              className="answer-input-box"
                              disabled={true}
                              id="1234@5-option-0"
                              name="1234@5-options"
                              onChange={[Function]}
                              type="radio"
                            />
                            <label
                              className="answer-label"
                              htmlFor="1234@5-option-0"
                            >
                              <span
                                aria-label="Choice A:"
                                className="answer-letter-wrapper"
                                data-answer-choice="A"
                                data-test-id="answer-choice-A"
                              />
                              <div
                                aria-atomic="true"
                                aria-live="polite"
                                className="answer-answer"
                                role="status"
                              >
                                <span
                                  className="c8 answer-content"
                                  dangerouslySetInnerHTML={
                                    Object {
                                      "__html": "True",
                                    }
                                  }
                                />
                              </div>
                            </label>
                          </section>
                        </div>
                        <aside
                          className="question-feedback bottom"
                          id="feedback-1234@5-0"
                        >
                          <div
                            aria-label="Answer Feedback"
                            className="arrow"
                          />
                          <aside>
                            <div
                              className="c8 question-feedback-content has-html"
                              dangerouslySetInnerHTML={
                                Object {
                                  "__html": "Feedback",
                                }
                              }
                            />
                          </aside>
                        </aside>
                        <div
                          className="openstax-answer"
                        >
                          <section
                            className="answers-answer disabled"
                          >
                            <input
                              checked={false}
                              className="answer-input-box"
                              disabled={true}
                              id="1234@5-option-1"
                              name="1234@5-options"
                              onChange={[Function]}
                              type="radio"
                            />
                            <label
                              className="answer-label"
                              htmlFor="1234@5-option-1"
                            >
                              <span
                                aria-label="Choice B:"
                                className="answer-letter-wrapper"
                                data-answer-choice="B"
                                data-test-id="answer-choice-B"
                              />
                              <div
                                aria-atomic="true"
                                aria-live="polite"
                                className="answer-answer"
                                role="status"
                              >
                                <span
                                  className="c8 answer-content"
                                  dangerouslySetInnerHTML={
                                    Object {
                                      "__html": "False",
                                    }
                                  }
                                />
                              </div>
                            </label>
                          </section>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  className="c11 step-card-footer"
                >
                  <div
                    className="step-card-footer-inner"
                  >
                    <div
                      className="points"
                    >
                      <div
                        className="c12"
                        role="status"
                      >
                        <div
                          className="detailed-solution"
                        >
                          <div
                            className="header"
                          >
                            Detailed solution:
                          </div>
                          <div
                            className="c8 solution"
                            dangerouslySetInnerHTML={
                              Object {
                                "__html": "<span data-math='e^{\\\\text{Blue}}'></span>",
                              }
                            }
                          />
                        </div>
                      </div>
                    </div>
                    <div
                      className="controls"
                    >
                      <button
                        className="c13"
                        data-test-id="continue-btn"
                        onClick={[Function]}
                      >
                        Next
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
