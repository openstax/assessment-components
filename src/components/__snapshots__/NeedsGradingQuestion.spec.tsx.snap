  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  gap: 0.8rem;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  text-align: left;
}

.c4 {
  font-size: calc(1.6rem * var(--content-text-scale));
  font-weight: 600;
  color: #424242;
  margin: 0;
}

.c5 {
  font-size: calc(1.3rem * var(--content-text-scale));
  font-weight: 600;
  color: #ffffff;
  background-color: #757575;
  border-radius: 5px;
  padding: 0.2rem 0.8rem;
}

.c10 {
  background: none;
  border: none;
  cursor: pointer;
  font-size: calc(1.2rem * var(--content-text-scale));
  color: #007da4;
  padding: 0;
  -webkit-text-decoration: underline;
  text-decoration: underline;
}

.c10:hover {
  color: #026AA1;
}

.c6 {
  padding: 1.6rem 1.6rem 0;
  background-color: #fdfdfd;
}

.c7 {
  font-size: calc(1.4rem * var(--content-text-scale));
  color: #424242;
}

.c9 {
  padding: 0.8rem 1.6rem 1.2rem;
  border-bottom: 1px solid #e5e5e5;
  background-color: #fdfdfd;
}

.c11 {
  background-color: #fdfdfd;
}

<div
  className="c0"
>
  <div
    className="c1"
  >
    <button
      aria-expanded={true}
      className="c2"
      onClick={[Function]}
      type="button"
    >
      <span
        className="c3"
      />
      <span
        className="c4"
      >
        Question 
        1
      </span>
    </button>
    <span
      className="c5"
    >
      1
      /
      2
       Graded
    </span>
  </div>
  <div
    style={
      Object {
        "display": undefined,
      }
    }
  >
    <div
      className="c6"
    >
      <div
        className="c7"
      >
        <div
          className="c8"
          dangerouslySetInnerHTML={
            Object {
              "__html": "<p>Describe Newton's first law.</p>",
            }
          }
        />
      </div>
    </div>
    <div
      className="c9"
    >
      <button
        className="c10"
        onClick={[Function]}
        type="button"
      >
        Expand all answers
      </button>
    </div>
    <div
      className="c11"
    >
      <div
        className="c12"
      >
        <button
          aria-expanded={true}
          className="c13"
          onClick={[Function]}
          type="button"
        >
          <span
            className="c3"
          />
          <span
            className="c14"
          >
            Ada Lovelace
          </span>
          <span
            className="c15"
          >
            <strong>
              Points:
            </strong>
             
            --
             out of 
            10
          </span>
        </button>
        <div
          className="c16"
          style={
            Object {
              "display": undefined,
            }
          }
        >
          <div
            className="c17"
          >
            <div
              className="c18"
            >
              An object at rest stays at rest.
            </div>
          </div>
          <div
            className="c19"
          >
            <div
              className="c20"
            >
              <div
                className="c21"
              >
                <label
                  className="c22"
                  htmlFor="frg-0-score"
                >
                  Points
                </label>
                <input
                  aria-label="Score"
                  className="c23"
                  disabled={false}
                  id="frg-0-score"
                  max={10}
                  min={0}
                  onChange={[Function]}
                  placeholder="--"
                  step={1}
                  type="number"
                  value=""
                />
                <span>
                  out of 
                  10
                </span>
              </div>
            </div>
            <div
              className="c20"
            >
              <label
                className="c22"
                htmlFor="frg-0-comment"
              >
                Comment
              </label>
              <textarea
                aria-label="Comment"
                className="c24"
                disabled={false}
                id="frg-0-comment"
                onChange={[Function]}
                placeholder="Enter feedback for the student..."
                value=""
              />
            </div>
            <div
              className="c25"
            >
              <button
                className="c26"
                disabled={true}
                onClick={[Function]}
              >
                Save
              </button>
            </div>
          </div>
        </div>
      </div>
      <div
        className="c12"
      >
        <button
          aria-expanded={false}
          className="c13"
          onClick={[Function]}
          type="button"
        >
          <span
            className="c27"
          />
          <span
            className="c14"
          >
