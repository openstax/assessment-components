          </span>
          <span
            className="c15"
          >
            <strong>
              Points:
            </strong>
             
            9
             out of 
            10
          </span>
        </button>
        <div
          className="c16"
          style={
            Object {
              "display": "none",
            }
          }
        >
          <div
            className="c17"
          >
            <div
              className="c18"
            >
              Things keep doing what they're doing.
            </div>
            <div
              className="c28"
            >
              <div
                className="c29"
              >
                Score: 
                9
                /
                10
              </div>
              <div
                className="c30"
              >
                <span
