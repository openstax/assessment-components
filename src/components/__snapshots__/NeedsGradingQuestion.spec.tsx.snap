                </label>
                <input
                  aria-label="Score"
                  className="c23"
                  disabled={false}
                  id="frg-1-score"
                  max={10}
                  min={0}
                  onChange={[Function]}
                  placeholder="--"
                  step={1}
                  type="number"
                  value="9"
                />
                <span>
