              </label>
              <textarea
                aria-label="Comment"
                className="c24"
                disabled={false}
                id="frg-1-comment"
                onChange={[Function]}
                placeholder="Enter feedback for the student..."
                value="Good answer."
              />
            </div>
            <div
              className="c25"
            >
              <button
                className="c26"
                disabled={true}
