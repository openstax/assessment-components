<div
  data-test-id="student-exercise-question"
>
  <div
    className="c0 openstax-question step-card-body has-incorrect-answer"
    data-question-number={1}
    data-test-id="question"
  >
    <div
      className="c1"
    >
      <div>
        <div
          className="c2 question-stem"
          dangerouslySetInnerHTML={
            Object {
              "__html": "Is this a question?",
            }
          }
          data-question-number={1}
        />
        <div
          aria-label="Answer choices"
          className="answers-table"
          role="radiogroup"
        >
          <div
            className="openstax-answer"
          >
            <section
              className="answers-answer disabled"
            >
              <input
                checked={false}
                className="answer-input-box"
                disabled={true}
                id="1-option-0"
                name="1-options"
                onChange={[Function]}
                type="radio"
              />
              <label
                className="answer-label"
                htmlFor="1-option-0"
              >
                <span
                  aria-label="Choice A:"
                  className="answer-letter-wrapper"
                  data-answer-choice="A"
                  data-test-id="answer-choice-A"
                />
                <div
                  aria-atomic="true"
                  aria-live="polite"
                  className="answer-answer"
                  role="status"
                >
                  <span
                    className="c2 answer-content"
                    dangerouslySetInnerHTML={
                      Object {
                        "__html": "True",
                      }
                    }
                  />
                </div>
              </label>
            </section>
          </div>
          <div
            className="openstax-answer"
          >
            <section
              className="answers-answer disabled answer-incorrect"
            >
              <input
                checked={false}
                className="answer-input-box"
                disabled={true}
                id="1-option-1"
                name="1-options"
                onChange={[Function]}
                type="radio"
              />
              <label
                className="answer-label"
                htmlFor="1-option-1"
              >
                <span
                  aria-label="Choice B:"
                  className="answer-letter-wrapper"
                  data-answer-choice="B"
                  data-test-id="answer-choice-B"
                />
                <div
                  aria-atomic="true"
                  aria-live="polite"
                  className="answer-answer"
                  role="status"
                >
                  <div
                    className="c3"
                  >
                    <span>
                      Incorrect Answer
                    </span>
                  </div>
                  <span
                    className="c2 answer-content"
                    dangerouslySetInnerHTML={
                      Object {
                        "__html": "False",
                      }
                    }
                  />
                </div>
              </label>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    className="c4 step-card-footer"
  >
    <div
      className="step-card-footer-inner"
    >
      <div
        className="controls"
      >
        <button
          className="c5"
          data-test-id="continue-btn"
          onClick={[Function]}
        >
          Continue
        </button>
      </div>
    </div>
  </div>
</div>
`;

