        >
          <div>
            1
             attempt
            
             left
          </div>
        </span>
      </div>
      <div
        className="controls"
      >
        <button
          className="c5"
          data-test-id="continue-btn"
          onClick={[Function]}
        >
          Next
        </button>
      </div>
    </div>
  </div>
</div>
`;
