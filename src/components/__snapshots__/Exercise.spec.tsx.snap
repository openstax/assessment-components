                  Object {
                    "__html": "Context",
                  }
                }
              />
              <div
                className="c4 c5 step-card-body exercise-stimulus"
                dangerouslySetInnerHTML={
                  Object {
                    "__html": "<b>Stimulus HTML</b>",
                  }
                }
              />
              <div
                data-test-id="student-exercise-question"
              >
                <div
                  className="c6 step-card-question step-card-body"
                >
                  <div
                    className="c7 openstax-question"
                    data-question-number={1}
                    data-test-id="question"
                  >
