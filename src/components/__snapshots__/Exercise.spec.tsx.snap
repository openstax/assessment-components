}

.c7.openstax-question:not(.openstax-question-preview) .question-feedback {
  font-family: "Neue Helvetica W01",Helvetica,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,"Noto Sans","Liberation Sans",sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji";
  font-style: normal;
  font-weight: 400;
  line-height: 1.6;
  text-align: left;
  text-align: start;
  -webkit-text-decoration: none;
  text-decoration: none;
  text-shadow: none;
  text-transform: none;
  -webkit-letter-spacing: normal;
  -moz-letter-spacing: normal;
  -ms-letter-spacing: normal;
  letter-spacing: normal;
  word-break: normal;
  word-spacing: normal;
  white-space: normal;
  line-break: auto;
  z-index: 1;
  position: relative;
  border: 1px solid rgba(0,0,0,0.2);
  background-color: #ffffff;
  background-clip: padding-box;
  max-width: 325px;
  margin: calc(8px - 14px) 0 1rem 8px;
  box-shadow: 0px 4px 4px rgba(0,0,0,0.1);
  color: #6f6f6f;
  font-size: calc(1.4rem * var(--content-text-scale,1));
  max-width: 370px;
}

.c7.openstax-question:not(.openstax-question-preview) .question-feedback .arrow {
  position: absolute;
  display: block;
  width: 16px;
  height: 8px;
  margin-left: 9px;
  top: calc(8px * -1);
}

.c7.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::before,
.c7.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::after {
  position: absolute;
  display: block;
  content: "";
  border-color: transparent;
  border-style: solid;
  border-width: 0 calc(16px / 2) 8px calc(16px / 2);
}

.c7.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::before {
  top: 0;
  border-bottom-color: rgba(0,0,0,0.2);
}

.c7.openstax-question:not(.openstax-question-preview) .question-feedback .arrow::after {
  top: 1px;
  border-bottom-color: #ffffff;
}

.c7.openstax-question:not(.openstax-question-preview) .question-feedback.right {
  right: calc(-9px - 1px);
}

.c7.openstax-question:not(.openstax-question-preview) .question-feedback.right .arrow {
  right: 9px;
}

.c7.openstax-question:not(.openstax-question-preview) .question-feedback > .content {
  padding: 1rem 0.8rem;
}

.c7.openstax-question:not(.openstax-question-preview) .question-feedback .question-feedback-content {
  padding: 0.9rem 1.1rem;
}

.c7.openstax-question .openstax-answer {
  border-top: 1px solid #d5d5d5;
  margin: 10px 0;
  padding: 6px 8px;
}

.c7.openstax-question .answers-table > :last-child,
.c7.openstax-question .answers-table > :last-child > .question-feedback,
.c7.openstax-question .answers-table > .openstax-answer:has(+ .question-feedback-live-region:last-child:empty) {
  margin-bottom: 0;
}

.c7.openstax-question .answers-table + * {
  margin-top: 20px;
}

.c11 .detailed-solution .header {
  display: inline;
  margin-right: 0.5rem;
  color: #5e6062;
  font-weight: bold;
  -webkit-flex-basis: 0;
  -ms-flex-preferred-size: 0;
  flex-basis: 0;
}

.c11 .detailed-solution .solution {
  display: inline;
  color: #6f6f6f;
}

.c10 {
  padding: 0 var(--step-card-gutter) var(--step-card-gutter-bottom);
  border-top: 1px solid #d5d5d5;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-wrap: wrap;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  font-size: calc(1.6rem * var(--content-text-scale,1));
  line-height: calc(2rem * var(--content-text-scale,1));
  background: #fdfdfd;
  overflow: auto;
}

.c10 > * {
  -webkit-box-flex: 1;
  -webkit-flex-grow: 1;
  -ms-flex-positive: 1;
  flex-grow: 1;
}

.c10 button {
  width: 160px;
  height: 48px;
}

.c10 .step-card-footer-inner {
  padding-top: 32px;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  gap: 1.6rem;
}

.c10 .points .attempts-left {
  color: #B03808;
  font-weight: bold;
}

.c10 .controls {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-flow: row nowrap;
  -ms-flex-flow: row nowrap;
  flex-flow: row nowrap;
  -webkit-box-pack: end;
  -webkit-justify-content: flex-end;
  -ms-flex-pack: end;
  justify-content: flex-end;
  gap: 0.8rem;
  margin-left: auto;
}

.c10 .controls button:has(~ button),
.c10 .controls button + button {
  -webkit-flex-shrink: 1;
  -ms-flex-negative: 1;
  flex-shrink: 1;
  min-width: 0;
  width: 100px;
}

@media (max-width:999px) {
  .c1 {
    --step-card-gutter: 24px;
    --step-card-gutter-top: 24px;
  }
}

@media (max-width:600px) {
  .c1 {
    --step-card-gutter: 8px;
    --step-card-gutter-top: calc(8px * 2);
  }
}

@media (min-width:1000px) {
  .c1 {
    max-width: 1000px;
  }
}

@media (max-width:600px) {
  .c0 {
    padding: 0;
  }
}

@media (min-width:1000px) {
  .c2 button.ox-icon-angle-left,
  .c2 button.ox-icon-angle-right {
    display: none;
  }
}

@media (max-width:999px) {
  .c2 {
    font-size: 1.6rem;
    line-height: 2.5rem;
  }

  .c2 svg.ox-icon {
    display: inherit;
    margin: 0;
  }

  .c2 button.ox-icon-angle-left {
    margin-right: 24px;
  }

  .c2 button.ox-icon-angle-right {
    margin-left: 24px;
  }

  .c2 .openstax-exercise-badges svg {
    display: none;
  }

  .c2 .num-questions,
  .c2 points {
    display: inherit;
  }

  .c2 .exercise-id {
    display: none;
  }

  .c2 button[class^='ox-icon-angle']:hover {
    box-shadow: none;
  }
}

@media (max-width:600px) {
  .c2 {
    font-size: 1.6rem;
    line-height: 2rem;
    padding: 10px 8px;
  }

  .c2 button.ox-icon-angle-left {
    margin-right: 8px;
  }

  .c2 button.ox-icon-angle-left {
    margin-right: 8px;
  }
}

@media (max-width:600px) {
  .c3.c3 .question-feedback {
    margin-left: 0;
  }

  .c3.c3 .question-feedback .arrow {
    margin-left: 12px;
  }
}

@media (max-width:600px) {
  .c3 .openstax-exercise-badges svg {
    margin-right: 8px;
  }
}

@media (max-width:600px) {
  .c10 .step-card-footer-inner {
    -webkit-flex-wrap: wrap;
    -ms-flex-wrap: wrap;
    flex-wrap: wrap;
  }
}

@media (min-width:1000px) {
  .c10 {
    padding: 0 var(--step-card-gutter) 32px;
    -webkit-flex-wrap: nowrap;
    -ms-flex-wrap: nowrap;
    flex-wrap: nowrap;
  }

  .c10 .points {
    max-width: 400px;
  }
}

<div
  className=""
>
  <div
    className="c0 step-card-outer"
    data-task-step-id="0"
  >
    <div
      className="c1 exercise-step"
    >
      <div>
        <div
          className="step-card"
        >
          <div
            className="c2 step-card-header"
          >
            <div>
              <h2
                className="question-info"
              >
                <span>
                  Question 1
                </span>
                <span
                  className="separator"
                >
                  |
                </span>
                <span
                  className="question-id"
                >
                  ID: 
                  1234@5
                </span>
              </h2>
            </div>
          </div>
          <div
            className="c3"
          >
            <div
              className=""
            >
              <div
                className="c4 c5 step-card-body exercise-context"
                dangerouslySetInnerHTML={
                  Object {
                    "__html": "Context",
                  }
                }
              />
              <div
                className="c4 c5 step-card-body exercise-stimulus"
                dangerouslySetInnerHTML={
                  Object {
                    "__html": "<b>Stimulus HTML</b>",
                  }
                }
              />
              <div
                data-test-id="student-exercise-question"
              >
                <div
                  className="c6 step-card-question step-card-body"
                >
                  <div
                    className="c7 openstax-question"
                    data-question-number={1}
                    data-test-id="question"
                  >
                    <div
                      className="c8"
                    >
                      <div>
                        <div
                          aria-label="Answer choices"
                          className="answers-table"
                          role="radiogroup"
                        >
                          <div
                            className="openstax-answer"
                          >
                            <div
                              className="answers-answer disabled answer-selected"
                            >
                              <input
                                checked={true}
                                className="answer-input-box"
                                disabled={true}
                                id="1-option-0"
                                name="1-options"
                                onChange={[Function]}
                                type="radio"
                              />
                              <label
                                className="answer-label"
                                htmlFor="1-option-0"
                              >
                                <span
                                  aria-hidden="true"
                                  className="answer-letter-wrapper"
                                  data-answer-choice="A"
                                  data-test-id="answer-choice-A"
                                />
                                <span
                                  className="c9 answer-choice-label"
                                >
                                  Choice A:
                                </span>
                                <div
                                  className="answer-answer"
                                >
                                  <div
                                    aria-atomic="true"
                                    aria-live="polite"
                                    className="answer-indicator-live"
                                    role="status"
                                  />
                                  <span
                                    className="c4 answer-content"
                                    dangerouslySetInnerHTML={
                                      Object {
                                        "__html": "True",
                                      }
                                    }
                                  />
                                </div>
                              </label>
                            </div>
                          </div>
                          <div
                            aria-atomic="true"
                            aria-live="polite"
                            className="question-feedback-live-region"
                          />
                          <div
                            className="openstax-answer"
                          >
                            <div
                              className="answers-answer disabled"
                            >
                              <input
                                checked={false}
                                className="answer-input-box"
                                disabled={true}
                                id="1-option-1"
                                name="1-options"
                                onChange={[Function]}
                                type="radio"
                              />
                              <label
                                className="answer-label"
                                htmlFor="1-option-1"
                              >
                                <span
                                  aria-hidden="true"
                                  className="answer-letter-wrapper"
                                  data-answer-choice="B"
                                  data-test-id="answer-choice-B"
                                />
                                <span
                                  className="c9 answer-choice-label"
                                >
                                  Choice B:
                                </span>
                                <div
                                  className="answer-answer"
                                >
                                  <div
                                    aria-atomic="true"
                                    aria-live="polite"
                                    className="answer-indicator-live"
                                    role="status"
                                  />
                                  <span
                                    className="c4 answer-content"
                                    dangerouslySetInnerHTML={
                                      Object {
                                        "__html": "False",
                                      }
                                    }
                                  />
                                </div>
                              </label>
                            </div>
                          </div>
                          <div
                            aria-atomic="true"
                            aria-live="polite"
                            className="question-feedback-live-region"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  className="c10 step-card-footer"
                >
                  <div
                    className="step-card-footer-inner"
                  >
                    <div
                      className="points"
                    >
                      <div
                        className="c11"
                        role="status"
                      >
                        <div
                          className="detailed-solution"
                        >
                          <div
                            className="header"
                          >
                            Detailed solution:
                          </div>
                          <div
                            className="c4 solution"
                            dangerouslySetInnerHTML={
                              Object {
                                "__html": "Detailed solution",
                              }
                            }
                          />
                        </div>
                      </div>
                    </div>
                    <div
                      className="controls"
                    >
                      <button
                        className="c12"
                        data-test-id="continue-btn"
                        onClick={[Function]}
                      >
                        Next
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
