                                </span>
                                <div
                                  className="answer-answer"
                                >
                                  <div
                                    aria-atomic="true"
                                    aria-live="polite"
                                    className="answer-indicator-live"
                                    role="status"
                                  />
                                  <span
                                    className="c4 answer-content"
                                    dangerouslySetInnerHTML={
                                      Object {
                                        "__html": "True",
                                      }
                                    }
                                  />
                                </div>
                              </label>
                            </div>
                          </div>
                          <div
                            aria-atomic="true"
                            aria-live="polite"
                            className="question-feedback-live-region"
                          />
                          <div
                            className="openstax-answer"
                          >
                            <div
                              className="answers-answer disabled"
                            >
                              <input
                                checked={false}
                                className="answer-input-box"
                                disabled={true}
                                id="1234@5-option-1"
                                name="1234@5-options"
                                onChange={[Function]}
                                type="radio"
                              />
                              <label
                                className="answer-label"
                                htmlFor="1234@5-option-1"
                              >
                                <span
                                  aria-hidden="true"
                                  className="answer-letter-wrapper"
                                  data-answer-choice="B"
                                  data-test-id="answer-choice-B"
                                />
                                <span
                                  className="c9 answer-choice-label"
                                >
                                  Choice B:
                                </span>
                                <div
                                  className="answer-answer"
                                >
                                  <div
                                    aria-atomic="true"
                                    aria-live="polite"
                                    className="answer-indicator-live"
                                    role="status"
                                  />
                                  <span
                                    className="c4 answer-content"
                                    dangerouslySetInnerHTML={
                                      Object {
                                        "__html": "False",
                                      }
                                    }
                                  />
                                </div>
                              </label>
                            </div>
                          </div>
                          <div
                            aria-atomic="true"
                            aria-live="polite"
                            className="question-feedback-live-region"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  className="c10 step-card-footer"
                >
                  <div
                    className="step-card-footer-inner"
                  >
                    <div
                      className="controls"
                    >
                      <button
                        className="c11"
                        data-test-id="continue-btn"
                        onClick={[Function]}
                      >
                        Next
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

