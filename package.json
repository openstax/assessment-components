{
  "name": "@openstax/assessment-components",
  "version": "1.5.1",
  "repository": "https://github.com/openstax/assessment-components.git",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "browser": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/esm/*",
        "dist/esm/*.d.ts",
        "dist/esm/*/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "./scripts/build.bash",
    "clean": "rm -rf ./dist",
    "build:clean": "npm run clean && npm run build",
    "dist": "npm run clean && npm run build",
    "dev": "./scripts/build.bash --watch",
    "build-download-json": "microbundle scripts/download-json.ts -o dist/scripts/download-json.js --target node --format cjs --sourcemap false",
    "download-json": "npm run build-download-json && npm run run-download-json",
    "run-download-json": "node dist/scripts/download-json.js",
    "generate-pdf": "rollup scripts/generate-pdf.ts -o dist/scripts/generate-pdf.mjs && node dist/scripts/generate-pdf.mjs",
    "download-json-to-pdf": "npm run download-json",
    "postdownload-json-to-pdf": "npm run generate-pdf",
    "generate-eoc-pdfs": "node scripts/generate-eoc-pdfs.js",
    "generate-chapter-reading-homework-pdfs": "microbundle scripts/generate-chapter-reading-homework-pdfs.ts -o dist/scripts/generate-chapter-reading-homework-pdfs.js --target node --format cjs --sourcemap false && node dist/scripts/generate-chapter-reading-homework-pdfs.js $@",
    "test": "jest --coverage .",
    "lint": "eslint src/*ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*",
    "styled-components": "*"
  },
  "devDependencies": {
    "@ladle/react": "^2.14.0",
    "@playwright/test": "^1.25.0",
    "@types/jest": "^28.1.4",
    "@types/lodash": "^4.14.195",
    "@types/node": "^18.7.5",
    "@types/node-fetch": "^2.6.2",
    "@types/react": "^17.0.20",
    "@types/react-dom": "^17.0.9",
    "@types/react-test-renderer": "^17.0.2",
    "@types/styled-components": "^5.1.25",
    "@typescript-eslint/eslint-plugin": "^5.30.6",
    "@typescript-eslint/parser": "^5.30.6",
    "eslint": "^8.19.0",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^28.1.2",
    "microbundle": "^0.15.1",
    "node-fetch": "<3.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-is": "^16.8.0",
    "react-test-renderer": "^17.0.2",
    "styled-components": "^5.3.5",
    "ts-jest": "^28.0.5",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "classnames": "^2.3.1",
    "jest-environment-jsdom": "^29.0.3",
    "lodash": "^4.17.21",
    "react-content-loader": "^6.2.0",
    "scroll-to-element": "^2.0.3",
    "weak-map": "^1.0.8"
  }
}
